{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expertiseos.local/schemas/export-manifest-v1.json",
  "title": "expertiseOS Portable Export Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "created_at", "source_product_version", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "export_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_product_version": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "path", "sha256", "bytes", "count"],
        "properties": {
          "record_type": {"enum": ["knowledge", "relationship", "source_reference", "approval_receipt", "learner_evidence", "learner_summary", "control", "progress", "deferred_activity"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
